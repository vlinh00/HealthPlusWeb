
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using HealthPlus.Client.Services
@inject AuthService AuthService

<div class="admin-shell">
    <aside class="admin-sidebar">
        <a href="/admin" class="admin-brand">
            <span class="admin-brand-icon"><i class="bi bi-heart-pulse-fill"></i></span>
            <span>Health<span>Plus</span></span>
        </a>

        <div class="admin-nav-label">QUẢN TRỊ HỆ THỐNG</div>

        <nav class="admin-nav">
            <NavLink href="/admin" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Tổng quan</span>
            </NavLink>
            <NavLink href="/admin/products">
                <i class="bi bi-box-seam"></i>
                <span>Sản phẩm</span>
            </NavLink>
            <NavLink href="/admin/categories">
                <i class="bi bi-tags"></i>
                <span>Danh mục</span>
            </NavLink>
            <NavLink href="/admin/orders">
                <i class="bi bi-receipt"></i>
                <span>Đơn hàng</span>
            </NavLink>
            <NavLink href="/admin/users">
                <i class="bi bi-people"></i>
                <span>Người dùng</span>
            </NavLink>
        </nav>

        <div class="admin-sidebar-bottom">
            <a href="/">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại cửa hàng</span>
            </a>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-caption">
                <span>HEALTHPLUS ADMIN</span>
                <strong>Khu vực quản trị</strong>
            </div>

            <div class="admin-topbar-user">
                <span class="admin-topbar-avatar">
                    <i class="bi bi-person-fill"></i>
                </span>
                <div>
                    <strong>@(AuthService.CurrentUser?.FullName ?? "Admin")</strong>
                    <small>Quản trị viên</small>
                </div>
            </div>
        </header>

        <main class="admin-content">
            @Body
        </main>
    </div>
</div>
