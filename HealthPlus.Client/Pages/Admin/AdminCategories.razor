
@page "/admin/categories"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using HealthPlus.Client.Services
@inject ApiService ApiService

<PageTitle>Quản lý danh mục | HealthPlus</PageTitle>

<div class="categories-admin">
    <div class="categories-admin-heading">
        <div>
            <span class="categories-admin-eyebrow">CATALOG ORGANIZATION</span>
            <h1>Quản lý danh mục</h1>
            <p>Tổ chức các nhóm sản phẩm để khách hàng dễ tìm kiếm.</p>
        </div>
        <button class="categories-admin-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg"></i> Thêm danh mục
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="categories-admin-alert success">@message</div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="categories-admin-alert error">@error</div>
    }

    <div class="categories-admin-toolbar">
        <div class="categories-admin-search">
            <i class="bi bi-search"></i>
            <input placeholder="Tìm danh mục..." @bind="search" @bind:event="oninput" />
        </div>
        <button class="categories-admin-secondary" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise"></i> Làm mới
        </button>
    </div>

    @if (loading)
    {
        <div class="categories-admin-state">Đang tải danh mục...</div>
    }
    else
    {
        var filtered = categories.Where(c =>
            string.IsNullOrWhiteSpace(search) ||
            c.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            (c.Description ?? "").Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

        <div class="categories-admin-table-wrap">
            <table class="categories-admin-table">
                <thead><tr><th>Danh mục</th><th>Mô tả</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                    @foreach (var c in filtered)
                    {
                        <tr>
                            <td>
                                <div class="categories-admin-name">
                                    <span><i class="bi bi-tags"></i></span>
                                    <div><strong>@c.Name</strong><small>ID #@c.Id</small></div>
                                </div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(c.Description) ? "Chưa có mô tả" : c.Description)</td>
                            <td>
                                <div class="categories-admin-actions">
                                    <button class="categories-admin-icon" title="Sửa" @onclick="() => OpenEdit(c)"><i class="bi bi-pencil"></i></button>
                                    <button class="categories-admin-icon danger" title="Xóa" @onclick="() => AskDelete(c)"><i class="bi bi-trash3"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (filtered.Count == 0)
        {
            <div class="categories-admin-empty">
                <i class="bi bi-tags"></i>
                <strong>Chưa có danh mục phù hợp</strong>
                <span>Thêm danh mục hoặc thay đổi từ khóa tìm kiếm.</span>
            </div>
        }
    }
</div>

@if (showForm)
{
    <div class="categories-admin-backdrop" @onclick="CloseForm">
        <section class="categories-admin-modal" @onclick:stopPropagation="true">
            <div class="categories-admin-modal-heading">
                <div>
                    <span class="categories-admin-eyebrow">CATEGORY DETAILS</span>
                    <h2>@(editingId.HasValue ? "Cập nhật danh mục" : "Thêm danh mục")</h2>
                </div>
                <button class="categories-admin-icon" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
            </div>

            <label class="categories-admin-field">
                Tên danh mục
                <input maxlength="100" @bind="form.Name" />
            </label>
            <label class="categories-admin-field">
                Mô tả
                <textarea rows="4" @bind="form.Description"></textarea>
            </label>

            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="categories-admin-alert error">@formError</div>
            }

            <div class="categories-admin-modal-actions">
                <button class="categories-admin-secondary" @onclick="CloseForm">Hủy</button>
                <button class="categories-admin-primary" @onclick="SaveAsync" disabled="@saving">
                    @(saving ? "Đang lưu..." : "Lưu danh mục")
                </button>
            </div>
        </section>
    </div>
}

@if (deleteTarget is not null)
{
    <div class="categories-admin-backdrop" @onclick="CancelDelete">
        <section class="categories-admin-modal small" @onclick:stopPropagation="true">
            <div class="categories-admin-delete-icon"><i class="bi bi-trash3"></i></div>
            <h2>Xóa danh mục?</h2>
            <p>Bạn có chắc muốn xóa <strong>@deleteTarget.Name</strong>? Máy chủ có thể từ chối nếu danh mục đang được sử dụng.</p>
            <div class="categories-admin-modal-actions">
                <button class="categories-admin-secondary" @onclick="CancelDelete">Hủy</button>
                <button class="categories-admin-danger" @onclick="DeleteAsync" disabled="@saving">Xác nhận xóa</button>
            </div>
        </section>
    </div>
}

@code {
    private List<CategoryDto> categories = [];
    private string search = "", error = "", message = "", formError = "";
    private bool loading, showForm, saving;
    private int? editingId;
    private CategoryRequest form = new();
    private CategoryDto? deleteTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = "";

        try
        {
            var result = await ApiService.GetAsync<ApiResponse<List<CategoryDto>>>("api/categories");
            if (result?.Success == true)
                categories = result.Data ?? [];
            else
                error = result?.Message ?? "Không tải được danh mục.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private void OpenCreate()
    {
        editingId = null;
        form = new();
        formError = "";
        showForm = true;
    }

    private void OpenEdit(CategoryDto c)
    {
        editingId = c.Id;
        form = new() { Name = c.Name, Description = c.Description };
        formError = "";
        showForm = true;
    }

    private void CloseForm() => showForm = false;
    private void AskDelete(CategoryDto c) => deleteTarget = c;
    private void CancelDelete() => deleteTarget = null;

    private async Task SaveAsync()
    {
        formError = "";

        if (string.IsNullOrWhiteSpace(form.Name))
        {
            formError = "Vui lòng nhập tên danh mục.";
            return;
        }

        saving = true;
        try
        {
            ApiResponse<CategoryDto>? result;

            if (editingId.HasValue)
                result = await ApiService.PutAsync<CategoryRequest, ApiResponse<CategoryDto>>($"api/categories/{editingId.Value}", form);
            else
                result = await ApiService.PostAsync<CategoryRequest, ApiResponse<CategoryDto>>("api/categories", form);

            if (result?.Success == true)
            {
                showForm = false;
                message = editingId.HasValue ? "Đã cập nhật danh mục." : "Đã tạo danh mục.";
                await LoadAsync();
            }
            else formError = result?.Message ?? "Không thể lưu danh mục.";
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { saving = false; }
    }

    private async Task DeleteAsync()
    {
        if (deleteTarget is null) return;
        saving = true;

        try
        {
            await ApiService.DeleteAsync($"api/categories/{deleteTarget.Id}");
            deleteTarget = null;
            message = "Đã gửi yêu cầu xóa danh mục.";
            await LoadAsync();
        }
        catch (Exception ex) { error = $"Không thể xóa danh mục: {ex.Message}"; }
        finally { saving = false; }
    }

    private sealed class ApiResponse<T> { public bool Success { get; set; } public string Message { get; set; } = ""; public T? Data { get; set; } }
    private sealed class CategoryDto { public int Id { get; set; } public string Name { get; set; } = ""; public string? Description { get; set; } }
    private sealed class CategoryRequest { public string Name { get; set; } = ""; public string? Description { get; set; } }
}
