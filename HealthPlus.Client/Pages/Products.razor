@page "/products"

@using Microsoft.AspNetCore.Components.Web
@using HealthPlus.Client.Models.Common
@using HealthPlus.Client.Models.Product
@using HealthPlus.Client.Services

@inject ApiService ApiService
@inject NavigationManager Navigation
@inject CartService CartService
@inject AuthService AuthService

<PageTitle>Sản phẩm | HealthPlus</PageTitle>

<div class="products-page">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="products-hero">

        <div class="container">

            <div class="products-hero-content">

                <span class="products-label">
                    <i class="bi bi-heart-pulse-fill"></i>
                    HEALTHPLUS
                </span>

                <h1>
                    Chăm sóc sức khỏe,
                    <span>bắt đầu từ hôm nay.</span>
                </h1>

                <p>
                    Khám phá các sản phẩm chăm sóc sức khỏe
                    chất lượng cho bạn và gia đình.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PRODUCTS
         ===================================================== -->

    <section class="products-section">

        <div class="container">

            <!-- TOOLBAR -->

            <div class="products-toolbar">

                <div class="products-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           placeholder="Tìm kiếm sản phẩm..."
                           @bind="searchText"
                           @bind:event="oninput"
                           @onkeydown="HandleSearchKeyDown" />

                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <button type="button"
                                class="search-clear"
                                @onclick="ClearSearch">

                            <i class="bi bi-x"></i>

                        </button>
                    }

                </div>


                <div class="products-filter">

                    <select @bind="sort">

                        <option value="">
                            Sắp xếp
                        </option>

                        <option value="price_asc">
                            Giá thấp → cao
                        </option>

                        <option value="price_desc">
                            Giá cao → thấp
                        </option>

                        <option value="name_asc">
                            Tên A → Z
                        </option>

                    </select>


                    <button type="button"
                            class="filter-button"
                            @onclick="ApplyFilterAsync"
                            disabled="@loading">

                        <i class="bi bi-sliders"></i>

                        Lọc

                    </button>

                </div>

            </div>


            <!-- RESULT HEADER -->

            <div class="products-result-header">

                @if (products != null)
                {
                    <div>

                        <strong>
                            Sản phẩm
                        </strong>

                        <span>
                            @products.TotalItems sản phẩm
                        </span>

                    </div>
                }

                @if (loading)
                {
                    <span class="result-loading">
                        Đang tải...
                    </span>
                }

            </div>


            <!-- =================================================
                 LOADING
                 ================================================= -->

            @if (loading && products == null)
            {
                <div class="product-grid">

                    @for (var i = 0; i < 8; i++)
                    {
                        <div class="product-card product-skeleton">

                            <div class="skeleton-image"></div>

                            <div class="skeleton-line"></div>

                            <div class="skeleton-line short"></div>

                            <div class="skeleton-price"></div>

                        </div>
                    }

                </div>
            }

            else if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="products-state">

                    <div class="state-icon error">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                    <h2>
                        Không thể tải sản phẩm
                    </h2>

                    <p>
                        @errorMessage
                    </p>

                    <button type="button"
                            class="products-primary-button"
                            @onclick="LoadProductsAsync">

                        <i class="bi bi-arrow-clockwise"></i>

                        Thử lại

                    </button>

                </div>
            }

            else if (products != null &&
                     products.Items.Count == 0)
            {
                <div class="products-state">

                    <div class="state-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h2>
                        Không tìm thấy sản phẩm
                    </h2>

                    <p>
                        Hãy thử tìm kiếm với từ khóa khác.
                    </p>

                    <button type="button"
                            class="products-outline-button"
                            @onclick="ClearSearch">

                        Xóa bộ lọc

                    </button>

                </div>
            }

            else if (products != null)
            {
                <div class="product-grid">

                    @foreach (var product in products.Items)
                    {
                        <article class="product-card">

                            <!-- IMAGE -->

                            <button type="button"
                                    class="product-image"
                                    @onclick="() => OpenProduct(product.Id)">

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         @onerror="HandleImageError" />
                                }
                                else
                                {
                                    <div class="product-placeholder">
                                        <i class="bi bi-capsule"></i>
                                    </div>
                                }

                            </button>


                            <!-- CONTENT -->

                            <div class="product-content">

                                <span class="product-category">
                                    @product.CategoryName
                                </span>


                                <button type="button"
                                        class="product-name"
                                        @onclick="() => OpenProduct(product.Id)">

                                    @product.Name

                                </button>


                                <div class="product-stock">

                                    @if (product.Stock > 0)
                                    {
                                        <i class="bi bi-check-circle-fill"></i>

                                        <span>
                                            Còn @product.Stock sản phẩm
                                        </span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill out"></i>

                                        <span class="out">
                                            Hết hàng
                                        </span>
                                    }

                                </div>


                                <div class="product-bottom">

                                    <strong>
                                        @product.Price.ToString("N0")đ
                                    </strong>

                                    <button type="button"
                                            class="product-detail-button"
                                            @onclick="() => OpenProduct(product.Id)">

                                        <i class="bi bi-arrow-up-right"></i>

                                    </button>

                                </div>


                                <button type="button"
                                        class="add-cart-button"
                                        @onclick="() => AddToCartAsync(product)"
                                        disabled="@(product.Stock <= 0)">

                                    <i class="bi bi-cart-plus"></i>

                                    @(product.Stock > 0
                                        ? "Thêm vào giỏ"
                                        : "Hết hàng")

                                </button>

                            </div>

                        </article>
                    }

                </div>


                <!-- =================================================
                     PAGINATION
                     ================================================= -->

                @if (products.TotalPages > 1)
                {
                    <div class="products-pagination">

                        <button type="button"
                                disabled="@(page <= 1 || loading)"
                                @onclick="PreviousPageAsync">

                            <i class="bi bi-chevron-left"></i>

                        </button>


                        @for (var i = 1;
                              i <= products.TotalPages;
                              i++)
                        {
                            var pageNumber = i;

                            <button type="button"
                                    class="@(pageNumber == page ? "active" : "")"
                                    disabled="@loading"
                                    @onclick="() => GoToPageAsync(pageNumber)">

                                @pageNumber

                            </button>
                        }


                        <button type="button"
                                disabled="@(page >= products.TotalPages || loading)"
                                @onclick="NextPageAsync">

                            <i class="bi bi-chevron-right"></i>

                        </button>

                    </div>
                }

            }

        </div>

    </section>

</div>


<!-- =========================================================
     TOAST
     ========================================================= -->

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="products-toast">

        <i class="bi bi-check-circle-fill"></i>

        <span>
            @toastMessage
        </span>

    </div>
}


@code {

    private PagedResult<ProductDto>? products;

    private string searchText = string.Empty;

    private string sort = string.Empty;

    private string errorMessage = string.Empty;

    private string toastMessage = string.Empty;

    private bool loading;

    private int page = 1;

    private const int PageSize = 8;


    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }


    private async Task LoadProductsAsync()
    {
        if (loading)
            return;

        loading = true;
        errorMessage = string.Empty;

        try
        {
            var url =
                $"api/products?page={page}&pageSize={PageSize}";

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                url +=
                    $"&search={Uri.EscapeDataString(searchText.Trim())}";
            }

            var response =
                await ApiService.GetAsync<
                    ApiResponse<PagedResult<ProductDto>>>(url);

            if (response == null)
            {
                errorMessage =
                    "API không trả về dữ liệu.";

                return;
            }

            if (!response.Success)
            {
                errorMessage =
                    response.Message;

                return;
            }

            products =
                response.Data;
        }
        catch (Exception ex)
        {
            errorMessage =
                string.IsNullOrWhiteSpace(ex.Message)
                    ? "Có lỗi xảy ra khi tải sản phẩm."
                    : ex.Message;
        }
        finally
        {
            loading = false;
        }
    }


    private async Task ApplyFilterAsync()
    {
        page = 1;

        await LoadProductsAsync();
    }


    private async Task HandleSearchKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            page = 1;

            await LoadProductsAsync();
        }
    }


    private async Task ClearSearch()
    {
        searchText = string.Empty;

        sort = string.Empty;

        page = 1;

        await LoadProductsAsync();
    }


    private async Task GoToPageAsync(int pageNumber)
    {
        if (pageNumber < 1)
            return;

        if (products == null)
            return;

        if (pageNumber > products.TotalPages)
            return;

        page = pageNumber;

        await LoadProductsAsync();

        await Task.Yield();
    }


    private async Task PreviousPageAsync()
    {
        if (page <= 1)
            return;

        page--;

        await LoadProductsAsync();
    }


    private async Task NextPageAsync()
    {
        if (products == null)
            return;

        if (page >= products.TotalPages)
            return;

        page++;

        await LoadProductsAsync();
    }


    private void OpenProduct(int productId)
    {
        Navigation.NavigateTo(
            $"/products/{productId}");
    }


    private async Task AddToCartAsync(
        ProductDto product)
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (product.Stock <= 0)
            return;

        try
        {
            await CartService.AddAsync(product.Id);

            toastMessage =
                $"{product.Name} đã được thêm vào giỏ.";

            StateHasChanged();

            await Task.Delay(2200);

            toastMessage = string.Empty;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            toastMessage =
                string.IsNullOrWhiteSpace(ex.Message)
                    ? "Không thể thêm sản phẩm vào giỏ."
                    : ex.Message;

            StateHasChanged();

            await Task.Delay(3000);

            toastMessage = string.Empty;

            StateHasChanged();
        }
    }


    private void HandleImageError(
        Microsoft.AspNetCore.Components.Web.ErrorEventArgs args)
    {
        // Nếu ảnh lỗi, giữ placeholder/không làm crash page.
    }

}