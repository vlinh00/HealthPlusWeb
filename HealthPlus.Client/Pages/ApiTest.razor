@page "/api-test"

@using HealthPlus.Client.Models.Common
@using HealthPlus.Client.Models.Product
@using HealthPlus.Client.Services

@inject ApiService ApiService

<h3>API Test</h3>

@if (products == null)
{
    <p>Loading...</p>
}
else
{
    <p>Total: @products.TotalItems</p>

    <ul>
        @foreach (var product in products.Items)
        {
            <li>
                @product.Name -
                @product.Price.ToString("N0")
            </li>
        }
    </ul>
}

@code {
    private PagedResult<ProductDto>? products;

    protected override async Task OnInitializedAsync()
    {
        var response =
            await ApiService.GetAsync<ApiResponse<PagedResult<ProductDto>>>(
                "api/products");

        if (response == null)
            throw new Exception("API returned no response.");

        if (!response.Success)
            throw new Exception(response.Message);

        products = response.Data;
    }
}