@page "/login"

@using HealthPlus.Client.Models.Auth
@using HealthPlus.Client.Services

@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đăng nhập | HealthPlus</PageTitle>

<div class="auth-page">

    <div class="auth-container">

        <div class="auth-card">

            <!-- =====================================================
                 LEFT - BRAND
                 ===================================================== -->

            <div class="auth-brand-panel">

                <a href="/" class="auth-brand">

                    <span class="auth-brand-icon">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </span>

                    <span>
                        Health<span>Plus</span>
                    </span>

                </a>


                <div class="auth-brand-content">

                    <span class="auth-brand-label">
                        CHĂM SÓC SỨC KHỎE
                    </span>

                    <h1>
                        Khỏe hơn,
                        <br />
                        mỗi ngày.
                    </h1>

                    <p>
                        Đăng nhập để quản lý giỏ hàng,
                        đơn hàng và trải nghiệm mua sắm
                        thuận tiện hơn.
                    </p>

                </div>


                <div class="auth-brand-footer">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Thông tin của bạn được bảo mật.
                    </span>

                </div>

            </div>


            <!-- =====================================================
                 RIGHT - FORM
                 ===================================================== -->

            <div class="auth-form-panel">

                <div class="auth-form-header">

                    <span class="auth-mobile-label">
                        HEALTHPLUS
                    </span>

                    <h2>
                        Chào mừng trở lại
                    </h2>

                    <p>
                        Đăng nhập vào tài khoản của bạn.
                    </p>

                </div>


                <div class="auth-form">

                    <!-- EMAIL -->

                    <div class="auth-field">

                        <label for="login-email">
                            Email
                        </label>

                        <div class="auth-input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <input id="login-email"
                                   type="email"
                                   placeholder="example@email.com"
                                   @bind="model.Email"
                                   @bind:event="oninput"
                                   disabled="@loading"
                                   autocomplete="email" />

                        </div>

                    </div>


                    <!-- PASSWORD -->

                    <div class="auth-field">

                        <label for="login-password">
                            Mật khẩu
                        </label>

                        <div class="auth-input-wrapper">

                            <i class="bi bi-lock"></i>

                            <input id="login-password"
                                   type="password"
                                   placeholder="Nhập mật khẩu"
                                   @bind="model.Password"
                                   @bind:event="oninput"
                                   @onkeydown="HandleKeyDown"
                                   disabled="@loading"
                                   autocomplete="current-password" />

                        </div>

                    </div>


                    <!-- MESSAGE -->

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="auth-message @(success ? "success" : "error")">

                            <i class="bi @(success
                                ? "bi-check-circle"
                                : "bi-exclamation-circle")">
                            </i>

                            <span>
                                @message
                            </span>

                        </div>
                    }


                    <!-- LOGIN BUTTON -->

                    <button type="button"
                            class="auth-submit-button"
                            @onclick="LoginAsync"
                            disabled="@loading">

                        @if (loading)
                        {
                            <span class="auth-spinner"></span>

                            <span>
                                Đang đăng nhập...
                            </span>
                        }
                        else
                        {
                            <span>
                                Đăng nhập
                            </span>

                            <i class="bi bi-arrow-right"></i>
                        }

                    </button>


                    <!-- DIVIDER -->

                    <div class="auth-divider">
                        <span>hoặc</span>
                    </div>


                    <!-- REGISTER -->

                    <div class="auth-register">

                        <span>
                            Chưa có tài khoản?
                        </span>

                        <button type="button"
                                @onclick="GoToRegister">

                            Đăng ký ngay

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    private LoginRequest model = new();

    private bool loading;
    private bool success;

    private string message = string.Empty;


    private async Task LoginAsync()
    {
        if (loading)
            return;

        message = string.Empty;

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            ShowError("Vui lòng nhập email.");
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Password))
        {
            ShowError("Vui lòng nhập mật khẩu.");
            return;
        }

        loading = true;

        try
        {
            var result =
                await AuthService.LoginAsync(model);

            if (!result.Success)
            {
                ShowError(result.Message);
                return;
            }

            success = true;
            message = "Đăng nhập thành công.";

            await Task.Delay(400);

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            ShowError(
                string.IsNullOrWhiteSpace(ex.Message)
                    ? "Đăng nhập thất bại."
                    : ex.Message);
        }
        finally
        {
            loading = false;
        }
    }


    private async Task HandleKeyDown(
        Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoginAsync();
        }
    }


    private void ShowError(string text)
    {
        success = false;
        message = text;
    }


    private void GoToRegister()
    {
        Navigation.NavigateTo("/register");
    }

}