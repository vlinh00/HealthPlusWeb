@page "/register"

@using HealthPlus.Client.Models.Auth
@using HealthPlus.Client.Services

@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đăng ký | HealthPlus</PageTitle>

<div class="auth-page">

    <div class="auth-container">

        <div class="auth-card register-card">

            <!-- LEFT -->

            <div class="auth-brand-panel">

                <a href="/" class="auth-brand">
                    <span class="auth-brand-icon">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </span>

                    <span>
                        Health<span>Plus</span>
                    </span>
                </a>


                <div class="auth-brand-content">

                    <span>
                        HEALTHPLUS
                    </span>

                    <h1>
                        Bắt đầu
                        <br />
                        sống khỏe.
                    </h1>

                    <p>
                        Tạo tài khoản để lưu giỏ hàng,
                        theo dõi đơn hàng và mua sắm
                        thuận tiện hơn.
                    </p>

                </div>


                <div class="register-benefits">

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Quản lý đơn hàng</span>
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Lưu sản phẩm trong giỏ</span>
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Mua sắm nhanh chóng</span>
                    </div>

                </div>

            </div>


            <!-- RIGHT -->

            <div class="auth-form-panel">

                <div class="auth-form-header">

                    <span class="auth-mobile-label">
                        HEALTHPLUS
                    </span>

                    <h2>
                        Tạo tài khoản
                    </h2>

                    <p>
                        Điền thông tin để bắt đầu sử dụng HealthPlus.
                    </p>

                </div>


                <div class="register-form">

                    <div class="register-form-row">

                        <div class="auth-field">

                            <label>
                                Họ và tên
                            </label>

                            <div class="auth-input-wrapper">

                                <i class="bi bi-person"></i>

                                <input type="text"
                                       placeholder="Nguyễn Văn A"
                                       @bind="model.FullName"
                                       disabled="@loading" />

                            </div>

                        </div>


                        <div class="auth-field">

                            <label>
                                Số điện thoại
                            </label>

                            <div class="auth-input-wrapper">

                                <i class="bi bi-phone"></i>

                                <input type="tel"
                                       placeholder="0901234567"
                                       @bind="model.Phone"
                                       disabled="@loading" />

                            </div>

                        </div>

                    </div>


                    <div class="auth-field">

                        <label>
                            Email
                        </label>

                        <div class="auth-input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <input type="email"
                                   placeholder="example@email.com"
                                   @bind="model.Email"
                                   disabled="@loading" />

                        </div>

                    </div>


                    <div class="register-form-row">

                        <div class="auth-field">

                            <label>
                                Mật khẩu
                            </label>

                            <div class="auth-input-wrapper">

                                <i class="bi bi-lock"></i>

                                <input type="password"
                                       placeholder="Tối thiểu 6 ký tự"
                                       @bind="model.Password"
                                       disabled="@loading" />

                            </div>

                        </div>


                        <div class="auth-field">

                            <label>
                                Xác nhận mật khẩu
                            </label>

                            <div class="auth-input-wrapper">

                                <i class="bi bi-lock-fill"></i>

                                <input type="password"
                                       placeholder="Nhập lại mật khẩu"
                                       @bind="confirmPassword"
                                       disabled="@loading" />

                            </div>

                        </div>

                    </div>


                    <div class="auth-field">

                        <label>
                            Địa chỉ
                            <span class="optional">
                                Không bắt buộc
                            </span>
                        </label>

                        <div class="auth-input-wrapper">

                            <i class="bi bi-geo-alt"></i>

                            <input type="text"
                                   placeholder="Địa chỉ giao hàng"
                                   @bind="model.Address"
                                   disabled="@loading" />

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="auth-message @(success ? "success" : "error")">

                            <i class="bi @(success
                                ? "bi-check-circle"
                                : "bi-exclamation-circle")"></i>

                            <span>
                                @message
                            </span>

                        </div>
                    }


                    <button class="auth-submit-button"
                            @onclick="RegisterAsync"
                            disabled="@loading">

                        @if (loading)
                        {
                            <span class="auth-spinner"></span>

                            <span>
                                Đang tạo tài khoản...
                            </span>
                        }
                        else
                        {
                            <span>
                                Tạo tài khoản
                            </span>

                            <i class="bi bi-arrow-right"></i>
                        }

                    </button>


                    <div class="auth-register">

                        <span>
                            Đã có tài khoản?
                        </span>

                        <button @onclick="GoToLogin">
                            Đăng nhập
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    private RegisterRequest model = new();

    private string confirmPassword = string.Empty;

    private bool loading;

    private bool success;

    private string message = string.Empty;


    private async Task RegisterAsync()
    {
        if (loading)
            return;


        message = string.Empty;


        if (string.IsNullOrWhiteSpace(model.FullName))
        {
            ShowError("Vui lòng nhập họ và tên.");
            return;
        }


        if (string.IsNullOrWhiteSpace(model.Email))
        {
            ShowError("Vui lòng nhập email.");
            return;
        }


        if (!model.Email.Contains("@"))
        {
            ShowError("Email không hợp lệ.");
            return;
        }


        if (string.IsNullOrWhiteSpace(model.Password))
        {
            ShowError("Vui lòng nhập mật khẩu.");
            return;
        }


        if (model.Password.Length < 6)
        {
            ShowError("Mật khẩu phải có ít nhất 6 ký tự.");
            return;
        }


        if (model.Password != confirmPassword)
        {
            ShowError("Mật khẩu xác nhận không khớp.");
            return;
        }


        loading = true;


        try
        {
            var result =
                await AuthService.RegisterAsync(model);


            if (!result.Success)
            {
                ShowError(result.Message);
                return;
            }


            success = true;

            message =
                "Đăng ký thành công. Đang chuyển đến trang đăng nhập...";


            await Task.Delay(1000);


            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }


    private void ShowError(string text)
    {
        success = false;

        message = text;
    }


    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

}