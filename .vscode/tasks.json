{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "HealthPlus API",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/HealthPlus.API/HealthPlus.API.csproj"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "HealthPlus Client",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/HealthPlus.Client/HealthPlus.Client.csproj"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "HealthPlus Full Stack",
            "dependsOn": [
                "HealthPlus API",
                "HealthPlus Client"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}